{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/paperfoot/agent-cli-framework/main/schemas/agent-info.schema.json",
  "title": "Agent CLI Framework capability manifest (agent-info)",
  "description": "The shape of `<tool> agent-info` output. Raw JSON, never wrapped in the output envelope. Every command listed must be routable in the binary.",
  "anyOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/scoped"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "name",
        "version",
        "description",
        "commands",
        "global_flags",
        "exit_codes",
        "envelope",
        "config",
        "auto_json_when_piped"
      ],
      "properties": {
        "status": false,
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/entry"
          }
        },
        "global_flags": {
          "type": "object",
          "required": [
            "--json",
            "--quiet"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string"
              },
              "default": {}
            },
            "additionalProperties": true
          }
        },
        "exit_codes": {
          "type": "object",
          "required": [
            "0",
            "1",
            "2",
            "3",
            "4"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "description": "0-4 keep their framework meaning. Domain codes 5 and above are allowed only when documented here."
        },
        "envelope": {
          "type": "object",
          "required": [
            "version",
            "success",
            "error"
          ],
          "properties": {
            "version": {
              "const": "1"
            },
            "success": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "config": {
          "type": "object",
          "required": [
            "path",
            "env_prefix"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "env_prefix": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*_$",
              "description": "Uppercase prefix ending in underscore, e.g. MYCLI_"
            }
          },
          "additionalProperties": true
        },
        "auto_json_when_piped": {
          "const": true
        }
      },
      "additionalProperties": true,
      "description": "Default `agent-info` output: the whole tool. Each command is one generated signature line (recommended) or a full command object."
    },
    "scoped": {
      "description": "`agent-info --command PATH`: name, version, and only the selected command(s) as full objects. Older tools that repeat the manifest's other fields still validate.",
      "type": "object",
      "required": [
        "name",
        "version",
        "commands"
      ],
      "properties": {
        "status": false,
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/command"
          }
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Signature line generated from the parser, e.g. \"<name> --style=: Greet someone\". The key is the command path."
        },
        {
          "$ref": "#/$defs/command"
        }
      ]
    },
    "command": {
      "type": "object",
      "required": [
        "description",
        "args",
        "options"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "mixed"
          ],
          "description": "Observable effects. A mixed command must explain flag-dependent behavior in effect_detail."
        },
        "idempotent": {
          "type": "boolean",
          "description": "Repeating the same request preserves its intended effects; not an exactly-once guarantee."
        },
        "effect_detail": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "description": "Argument arrays excluding the executable. Never automatically execute them during generic conformance."
        },
        "output_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "arg": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "positional"
          ]
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^--"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "values": {
          "type": "array"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
